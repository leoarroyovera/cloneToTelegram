[Unit]
Description=cloneToTelegram control bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/cloneToTelegram
ExecStart=/home/ubuntu/cloneToTelegram/venv/bin/python bot.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
